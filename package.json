{
  "name": "montag-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Montage Studio — ستوديو المونتاج والموشن جرافيك في المتصفح (شبيه بـ Adobe After Effects): خط زمني، مفاتيح، تأثيرات، أقنعة، منحنيات، وتصدير فيديو/صور/صوت",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node tests/run.js",
    "build:apk": "node tools/make-apk.mjs",
    "build:exe": "node tools/make-exe.mjs && node tools/patch-exe-icon.mjs || node tools/make-exe.mjs",
    "build:ico": "node tools/make-ico.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "video-editor",
    "motion-graphics",
    "after-effects",
    "timeline",
    "keyframes",
    "canvas",
    "montage",
    "arabic-ui"
  ],
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@postar/apktool-node": "^0.3.4",
    "bun": "^1.4.2",
    "electron": "^44.3.0",
    "jsdom": "^25.0.1",
    "resedit": "^3.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y5747m-gif/montag-est-.git"
  }
}